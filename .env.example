# Copy sang .env (không commit .env thật) rồi điền giá trị thật khi chạy `docker compose up`.

# --- auth-service / auth-db ---
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=changeme

# HS256 yêu cầu secret >= 32 bytes. Tạo bằng: openssl rand -base64 64
JWT_SECRET=changeme
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Tài khoản Admin mặc định, tự seed lúc auth-service khởi động lần đầu (idempotent).
ADMIN_EMAIL=admin@vetclinic.local
ADMIN_PASSWORD=changeme

# --- profile-service / profile-db ---
PROFILE_DB_USER=postgres
PROFILE_DB_PASSWORD=changeme

# --- booking-service / booking-db ---
BOOKING_DB_USER=postgres
BOOKING_DB_PASSWORD=changeme

# --- product-service / product-db ---
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=changeme

# --- order-service / order-db ---
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=changeme
# Phi giao hang co dinh (VND)
ORDER_SHIPPING_FEE=30000

# --- payment-service / payment-db ---
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASSWORD=changeme

# --- RabbitMQ (auth-service publish "user.deleted", profile-service subscribe để dọn dữ liệu mồ côi) ---
# KHÔNG để mặc định "guest" khi chạy qua docker-compose — user "guest" mặc định của RabbitMQ chỉ
# được phép kết nối từ localhost, còn các service khác kết nối qua network Docker sẽ bị từ chối.
RABBITMQ_USER=vetclinic
RABBITMQ_PASSWORD=changeme

# --- notification-service / MailHog ---
# Link xác thực trong email phải mở được từ trình duyệt người dùng — để mặc định localhost khi dev.
FRONTEND_URL=http://localhost:3000
# Dev mặc định dùng MailHog (không cần khai gì thêm). Khi đổi sang SMTP thật, bỏ comment và điền:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=app-password-16-ky-tu
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
