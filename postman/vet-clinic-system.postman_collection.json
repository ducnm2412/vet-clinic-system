{
  "info": {
    "_postman_id": "a1e4c9a0-1234-4a2e-9b1a-vetclinicpm01",
    "name": "Vet Clinic System - Full API",
    "description": "Bo test toan bo API cua vet-clinic-system qua API Gateway (localhost:8080). Chay lan luot tu tren xuong duoi (theo dung thu tu cac folder/request da danh so) de cac bien (token, id) duoc tu dong luu vao Environment va dung lai cho cac request sau.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tinh san 1 ngay trong tuong lai (7 ngay ke tu hom nay) dung chung cho tat ca request",
          "// can 'date' (tao slot, dat lich, xem available-times...) - chi tinh 1 lan roi luu vao",
          "// environment de moi request trong ca collection dung CHUNG 1 ngay.",
          "if (!pm.environment.get('testDate')) {",
          "    const d = new Date();",
          "    d.setDate(d.getDate() + 7);",
          "    const iso = d.toISOString().slice(0, 10);",
          "    pm.environment.set('testDate', iso);",
          "}"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "01. Auth - Setup",
      "item": [
        {
          "name": "01 - Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"confirmPassword\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Tao tai khoan CUSTOMER. Status mac dinh la INACTIVE, phai xac thuc email (request tiep theo) moi login duoc."
          }
        },
        {
          "name": "02 - Verify Email (Customer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tu dong lay verification token tu MailHog thay vi phai copy tay (copy tay rat de",
                  "// dinh ky tu thua neu lo xem o tab 'Source'/'Raw' cua MailHog - noi dung email o do",
                  "// van con o dang quoted-printable, vd token bi cat thanh 'abc=\\r\\ndef' hoac '=3D'",
                  "// thay vi '='. Script nay goi thang MailHog API, tu giai ma quoted-printable roi",
                  "// tach token chinh xac, khoi can vao UI MailHog nua.",
                  "(async () => {",
                  "    const mailhogUrl = pm.environment.get('mailhogUrl') || 'http://localhost:8025';",
                  "    const targetEmail = pm.environment.get('customerEmail');",
                  "",
                  "    const res = await pm.sendRequest({",
                  "        url: mailhogUrl + '/api/v2/messages?limit=50',",
                  "        method: 'GET'",
                  "    });",
                  "    const data = res.json();",
                  "    const items = (data && data.items) || [];",
                  "",
                  "    const match = items.find(function (item) {",
                  "        const to = (item.Content && item.Content.Headers && item.Content.Headers.To) || [];",
                  "        return to.some(function (t) { return t.indexOf(targetEmail) !== -1; });",
                  "    });",
                  "",
                  "    if (!match) {",
                  "        console.warn('[Verify Email] Khong tim thay email nao gui toi ' + targetEmail +",
                  "            ' trong MailHog (' + mailhogUrl + '). Chay lai request 01 - Register Customer truoc.');",
                  "        return;",
                  "    }",
                  "",
                  "    let body = match.Content.Body || '';",
                  "    // Bo soft line-break cua quoted-printable roi decode '=XX' -> ky tu that.",
                  "    body = body.replace(/=\\r\\n/g, '').replace(/=\\n/g, '');",
                  "    body = body.replace(/=([0-9A-Fa-f]{2})/g, function (_, hex) {",
                  "        return String.fromCharCode(parseInt(hex, 16));",
                  "    });",
                  "",
                  "    const tokenMatch = body.match(/token=([^\"&]+)/);",
                  "    if (tokenMatch) {",
                  "        pm.environment.set('customerVerificationToken', tokenMatch[1]);",
                  "        console.log('[Verify Email] Da tu dong lay token:', tokenMatch[1]);",
                  "    } else {",
                  "        console.warn('[Verify Email] Tim thay email nhung khong parse duoc token trong noi dung.');",
                  "    }",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verify email thanh cong', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/verify-email?token={{customerVerificationToken}}",
            "description": "Token duoc TU DONG lay tu MailHog ({{mailhogUrl}}) va giai ma dung o Pre-request Script - chi can bam Send. Neu van loi 400, xem tab Console (View > Show Postman Console) de biet email da toi MailHog chua."
          }
        },
