    {
      "name": "09. Booking - Appointments",
      "item": [
        {
          "name": "32 - Create Appointment (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dat lich thanh cong hoac bi full (409)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('appointmentId', pm.response.json().id);",
                  "} else if (pm.response.code === 409) {",
                  "    console.log('Slot da day, xem goi y trong suggestedTimes:', pm.response.json().suggestedTimes);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"date\": \"{{testDate}}\",\n  \"startTime\": \"09:00:00\",\n  \"reason\": \"Kham suc khoe dinh ky\"\n}"
            },
            "url": "{{baseUrl}}/booking/appointments",
            "description": "Khach hang KHONG chon bac si - he thong tu gan bac si dang ranh & it lich nhat vao khung gio nay. Neu tra 409 (SlotFullyBooked), response se co field 'suggestedTimes' goi y khung gio khac - khong can goi API rieng."
          }
        },
        {
          "name": "33 - List My Appointments (Customer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/booking/appointments/me"
          }
        },
        {
          "name": "34 - List My Doctor Appointments (Doctor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }],
            "url": "{{baseUrl}}/booking/appointments/doctor/me?date={{testDate}}"
          }
        },
        {
          "name": "35 - Search Appointments (Staff/Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": "{{baseUrl}}/booking/appointments?date={{testDate}}",
            "description": "Cac query param date/status/doctorUserId deu optional, co the bo trong de lay tat ca."
          }
        },
        {
          "name": "36 - Get Appointment Detail (Doctor/Staff/Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }],
            "url": "{{baseUrl}}/booking/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "37 - Update Appointment Status -> CONFIRMED",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/booking/appointments/{{appointmentId}}/status",
            "description": "status: PENDING | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW"
          }
        }
      ]
    },
    {
      "name": "10. Booking - Medical Record & Payment",
      "item": [
        {
          "name": "38 - Create/Update Medical Record (Doctor)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosis\": \"Viem da di ung\",\n  \"treatment\": \"Ke thuoc khang viem, ve sinh vung da bi anh huong\",\n  \"notes\": \"Tai kham sau 1 tuan neu khong do\",\n  \"prescriptionItems\": [\n    {\n      \"medicationName\": \"Cetirizine\",\n      \"dosage\": \"5mg\",\n      \"frequency\": \"1 lan/ngay\",\n      \"durationDays\": 7,\n      \"notes\": \"Uong sau an\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/medical-records/by-appointment/{{appointmentId}}",
            "description": "Neu co prescriptionItems, mot Payment tuong ung se duoc tao (qua event) ben payment-service voi trang thai PENDING, staff se set amount va xac nhan thanh toan tien mat o cac request sau."
          }
        },
        {
          "name": "39 - Get Medical Record",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/medical-records/by-appointment/{{appointmentId}}"
          }
        },
        {
          "name": "40 - List Pending Payments (Staff/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    if (Array.isArray(json) && json.length > 0) {",
                  "        pm.environment.set('paymentId', json[0].id);",
                  "    } else {",
                  "        console.log('Chua co payment nao pending - hay chac chan buoc 38 co prescriptionItems va da chay xong.');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": "{{baseUrl}}/payment/payments/pending"
          }
        },
        {
          "name": "41 - Set Payment Amount (Staff/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150000\n}"
            },
            "url": "{{baseUrl}}/payment/payments/{{paymentId}}/amount"
          }
        },
        {
          "name": "42 - Confirm Cash Payment (Staff/Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": "{{baseUrl}}/payment/payments/{{paymentId}}/confirm-cash"
          }
        },
        {
          "name": "43 - List Pending Prescriptions (Staff/Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": "{{baseUrl}}/medical-records/pending",
            "description": "Danh sach don thuoc da PAID, cho staff tiep nhan. Chay sau buoc 42 (confirm-cash) thi don o buoc 38 moi xuat hien o day."
          }
        },
        {
          "name": "44 - Receive Prescription (Staff/Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffAccessToken}}" }],
            "url": "{{baseUrl}}/medical-records/by-appointment/{{appointmentId}}/receive",
            "description": "Chuyen PAID -> RECEIVED. Neu con PENDING (chua thanh toan) se tra 409."
          }
        }
      ]
    },
    {
      "name": "11. Optional - Destructive / Cleanup",
      "description": "Cac request xoa/huy du lieu - CHI chay khi ban thuc su muon don dep, vi chay xong se lam hong du lieu de test lai cac buoc phia tren.",
      "item": [
        {
          "name": "45 - Cancel Appointment (Customer/Staff/Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/booking/appointments/{{appointmentId}}/cancel"
          }
        },
        {
          "name": "46 - Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/profile/customer/me/addresses/{{addressId}}"
          }
        },
        {
          "name": "47 - Delete Pet",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/pets/me/{{petId}}"
          }
        },
        {
          "name": "48 - Delete Doctor License",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorAccessToken}}" }],
            "url": "{{baseUrl}}/profile/doctor/me/licenses/{{licenseId}}"
          }
        },
        {
          "name": "49 - Delete User (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": "{{baseUrl}}/admin/users/{{userIdToDelete}}",
            "description": "Dien thu cong bien 'userIdToDelete' (UUID) truoc khi goi - vd de xoa tai khoan doctor/staff test vua tao."
          }
        }
      ]
    }
  ]
}
