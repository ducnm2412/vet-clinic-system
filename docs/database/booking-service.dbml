// Sơ đồ CSDL của booking-service (database booking_db). Dán vào https://dbdiagram.io/d

Table appointment_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  doctor_user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  status varchar(20) [not null, default: 'AVAILABLE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (doctor_user_id, date, start_time) [unique]
  }
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  slot_id uuid
  customer_user_id uuid [not null]
  pet_id uuid [not null]
  reason text
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  service_id uuid
  preferred_date date
  preferred_time time
  proposed_date date
  proposed_time time
  customer_email varchar(255)
  pet_name varchar(100)
}

Table blocked_doctors {
  doctor_user_id uuid [pk]
  blocked_at timestamptz [not null, default: `now()`]
}

Table clinic_services {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar(80) [not null, unique]
  name varchar(120) [not null]
  description text
  duration_minutes integer [not null, default: 30]
  reference_price numeric(12,2)
  active boolean [not null, default: `true`]
  display_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table doctor_shifts {
  id uuid [pk, default: `gen_random_uuid()`]
  doctor_user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (doctor_user_id, date, start_time) [unique]
  }
}

// ===== Khoá ngoại trong database =====
Ref: appointments.slot_id > appointment_slots.id
Ref: appointments.service_id > clinic_services.id

// ===== Tham chiếu sang service khác (UUID, không có FK thật; không vẽ vì bảng nằm ở DB khác) =====
// appointments.customer_user_id > users.id  [auth-service]
// appointment_slots.doctor_user_id > users.id  [auth-service]
// doctor_shifts.doctor_user_id > users.id  [auth-service]
// appointments.pet_id > pets.id  [pet-service]
// medical_records.appointment_id - appointments.id  [pet-service]
// payments.appointment_id > appointments.id  [payment-service]

TableGroup booking_service {
  appointment_slots
  appointments
  blocked_doctors
  clinic_services
  doctor_shifts
}
