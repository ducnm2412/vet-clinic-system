// Sơ đồ CSDL của staff-service (database staff_db). Dán vào https://dbdiagram.io/d

Table attendance_records {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  auto_closed boolean [not null, default: `false`]
  indexes {
    (user_id, date) [unique]
  }
}

Table leaves {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  reason varchar(500)
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, date) [unique]
  }
}

Table shifts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  note varchar(500)
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, date, start_time) [unique]
  }
}

// ===== Khoá ngoại trong database =====

// ===== Tham chiếu sang service khác (UUID, không có FK thật; không vẽ vì bảng nằm ở DB khác) =====
// shifts.user_id > users.id  [auth-service]
// shifts.created_by > users.id  [auth-service]
// attendance_records.user_id > users.id  [auth-service]
// leaves.user_id > users.id  [auth-service]
// leaves.created_by > users.id  [auth-service]

TableGroup staff_service {
  attendance_records
  leaves
  shifts
}
