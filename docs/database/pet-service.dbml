// Sơ đồ CSDL của pet-service (database pet_db). Dán vào https://dbdiagram.io/d

Table medical_records {
  id uuid [pk, default: `gen_random_uuid()`]
  appointment_id uuid [not null, unique]
  pet_id uuid [not null]
  customer_user_id uuid [not null]
  doctor_user_id uuid [not null]
  diagnosis text [not null]
  treatment text
  notes text
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table pets {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_user_id uuid [not null]
  name varchar(100) [not null]
  species varchar(50) [not null]
  breed varchar(100)
  gender varchar(10)
  date_of_birth date
  weight_kg numeric(5,2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  allergies text
  notes text
  photo_version integer [not null, default: 0]
  photo_url varchar(500)
}

Table prescription_items {
  id uuid [pk, default: `gen_random_uuid()`]
  medical_record_id uuid [not null]
  medication_name varchar(255) [not null]
  dosage varchar(100) [not null]
  frequency varchar(100) [not null]
  duration_days integer
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ===== Khoá ngoại trong database =====
Ref: medical_records.pet_id > pets.id
Ref: prescription_items.medical_record_id > medical_records.id

// ===== Tham chiếu sang service khác (UUID, không có FK thật; không vẽ vì bảng nằm ở DB khác) =====
// pets.owner_user_id > users.id  [auth-service]
// medical_records.customer_user_id > users.id  [auth-service]
// medical_records.doctor_user_id > users.id  [auth-service]
// appointments.pet_id > pets.id  [booking-service]
// medical_records.appointment_id - appointments.id  [booking-service]
// payments.medical_record_id > medical_records.id  [payment-service]

TableGroup pet_service {
  medical_records
  pets
  prescription_items
}
