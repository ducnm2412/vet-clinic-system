// Sơ đồ CSDL của product-service (database product_db). Dán vào https://dbdiagram.io/d

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table medication_stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  medication_id uuid [not null]
  type varchar(20) [not null]
  quantity_change integer [not null]
  quantity_after integer [not null]
  shortfall integer [not null, default: 0]
  note varchar(500)
  reference_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (medication_id, reference_id, type) [unique]
  }
}

Table medications {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  search_name varchar(255) [not null]
  unit varchar(50)
  caution text
  active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  unit_price numeric(12,2)
  stock_quantity integer [not null, default: 0]
  low_stock_threshold integer [not null, default: 0]
}

Table prescription_template_items {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  medication_id uuid [not null]
  dosage varchar(100) [not null]
  frequency varchar(100) [not null]
  duration_days integer
  notes text
  sort_order integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table prescription_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  search_name varchar(150) [not null]
  diagnosis text [not null]
  treatment text
  notes text
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  sku varchar(64) [not null, unique]
  name varchar(200) [not null]
  description text
  price numeric(12,2) [not null]
  unit varchar(30) [not null]
  image_url varchar(500)
  stock_quantity integer [not null, default: 0]
  low_stock_threshold integer [not null, default: 0]
  active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  type varchar(20) [not null]
  quantity_change integer [not null]
  quantity_after integer [not null]
  note varchar(500)
  reference_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, reference_id, type) [unique]
  }
}

// ===== Khoá ngoại trong database =====
Ref: products.category_id > categories.id
Ref: stock_movements.product_id > products.id
Ref: prescription_template_items.template_id > prescription_templates.id
Ref: prescription_template_items.medication_id > medications.id
Ref: medication_stock_movements.medication_id > medications.id

// ===== Tham chiếu sang service khác (UUID, không có FK thật; không vẽ vì bảng nằm ở DB khác) =====
// stock_movements.created_by > users.id  [auth-service]
// medication_stock_movements.created_by > users.id  [auth-service]
// prescription_templates.created_by > users.id  [auth-service]
// cart_items.product_id > products.id  [order-service]
// order_items.product_id > products.id  [order-service]

TableGroup product_service {
  categories
  medication_stock_movements
  medications
  prescription_template_items
  prescription_templates
  products
  stock_movements
}
