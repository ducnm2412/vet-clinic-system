// Sơ đồ CSDL của order-service (database order_db). Dán vào https://dbdiagram.io/d

Table cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (cart_id, product_id) [unique]
  }
}

Table carts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid [not null]
  sku varchar(64) [not null]
  product_name varchar(200) [not null]
  unit_price numeric(12,2) [not null]
  quantity integer [not null]
  line_total numeric(14,2) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table order_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_by uuid
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_code varchar(20) [not null, unique]
  user_id uuid
  status varchar(20) [not null]
  payment_method varchar(20)
  recipient_name varchar(200) [not null]
  recipient_phone varchar(20) [not null]
  shipping_address varchar(500) [not null]
  note varchar(500)
  subtotal numeric(14,2) [not null]
  shipping_fee numeric(14,2) [not null]
  total numeric(14,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancel_reason varchar(500)
  channel varchar(20) [not null, default: 'ONLINE']
  exam_payment_id uuid
  exam_amount numeric(14,2) [not null, default: 0]
  payment_status varchar(20) [not null, default: 'UNPAID']
  paid_at timestamptz
  transfer_reference varchar(100)
  payment_expires_at timestamptz
  gateway_txn_ref varchar(64)
  gateway_txn_created_at timestamptz
  customer_email varchar(255)
  assigned_staff_id uuid
  assigned_staff_name varchar(200)
  assigned_at timestamptz
}

// ===== Khoá ngoại trong database =====
Ref: cart_items.cart_id > carts.id
Ref: order_items.order_id > orders.id
Ref: order_status_history.order_id > orders.id

// ===== Tham chiếu sang service khác (UUID, không có FK thật; không vẽ vì bảng nằm ở DB khác) =====
// carts.user_id > users.id  [auth-service]
// orders.user_id > users.id  [auth-service]
// orders.assigned_staff_id > users.id  [auth-service]
// order_status_history.changed_by > users.id  [auth-service]
// orders.exam_payment_id - payments.id  [payment-service]
// cart_items.product_id > products.id  [product-service]
// order_items.product_id > products.id  [product-service]

TableGroup order_service {
  cart_items
  carts
  order_items
  order_status_history
  orders
}
