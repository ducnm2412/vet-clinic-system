// Sơ đồ CSDL hiện tại của vet-clinic-system (sinh từ 9 database PostgreSQL đang chạy).
// Dán vào https://dbdiagram.io/d để xem. Mỗi service có database riêng (xem TableGroup).
// Ref cùng service = khoá ngoại thật trong DB; Ref 'giữa các service' = tham chiếu logic bằng UUID (không có FK).
Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table roles {
  id integer [pk, increment]
  name varchar(20) [not null, unique]
}

Table user_roles {
  user_id uuid [not null]
  role_id integer [not null]
  indexes {
    (user_id, role_id) [pk]
  }
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash varchar(255)
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  verification_token varchar(255)
  verification_token_expires_at timestamptz
  google_sub varchar(255) [unique]
  facebook_id varchar(255) [unique]
}

Table addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_profile_id uuid [not null]
  line1 varchar(255) [not null]
  line2 varchar(255)
  ward varchar(100)
  city varchar(100) [not null]
  is_default boolean [not null, default: `false`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table customer_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  phone varchar(20)
  date_of_birth date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  photo_version integer [not null, default: 0]
  gender varchar(10)
  photo_url varchar(500)
}

Table doctor_licenses {
  id uuid [pk, default: `gen_random_uuid()`]
  doctor_profile_id uuid [not null]
  license_number varchar(100) [not null]
  issued_by varchar(255) [not null]
  issued_date date [not null]
  expiry_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table doctor_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  specialty varchar(100) [not null]
  phone varchar(20)
  bio text
  years_of_experience integer
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  full_name varchar(200)
  photo_version integer [not null, default: 0]
  photo_url varchar(500)
}

Table staff_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  position varchar(100) [not null]
  phone varchar(20)
  hire_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  photo_version integer [not null, default: 0]
  photo_url varchar(500)
}

Table appointment_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  doctor_user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  status varchar(20) [not null, default: 'AVAILABLE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (doctor_user_id, date, start_time) [unique]
  }
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  slot_id uuid
  customer_user_id uuid [not null]
  pet_id uuid [not null]
  reason text
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  service_id uuid
  preferred_date date
  preferred_time time
  proposed_date date
  proposed_time time
  customer_email varchar(255)
  pet_name varchar(100)
}

Table blocked_doctors {
  doctor_user_id uuid [pk]
  blocked_at timestamptz [not null, default: `now()`]
}

Table clinic_services {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar(80) [not null, unique]
  name varchar(120) [not null]
  description text
  duration_minutes integer [not null, default: 30]
  reference_price numeric(12,2)
  active boolean [not null, default: `true`]
  display_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table doctor_shifts {
  id uuid [pk, default: `gen_random_uuid()`]
  doctor_user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (doctor_user_id, date, start_time) [unique]
  }
}

Table medical_records {
  id uuid [pk, default: `gen_random_uuid()`]
  appointment_id uuid [not null, unique]
  pet_id uuid [not null]
  customer_user_id uuid [not null]
  doctor_user_id uuid [not null]
  diagnosis text [not null]
  treatment text
  notes text
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table pets {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_user_id uuid [not null]
  name varchar(100) [not null]
  species varchar(50) [not null]
  breed varchar(100)
  gender varchar(10)
  date_of_birth date
  weight_kg numeric(5,2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  allergies text
  notes text
  photo_version integer [not null, default: 0]
  photo_url varchar(500)
}

Table prescription_items {
  id uuid [pk, default: `gen_random_uuid()`]
  medical_record_id uuid [not null]
  medication_name varchar(255) [not null]
  dosage varchar(100) [not null]
  frequency varchar(100) [not null]
  duration_days integer
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table medication_stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  medication_id uuid [not null]
  type varchar(20) [not null]
  quantity_change integer [not null]
  quantity_after integer [not null]
  shortfall integer [not null, default: 0]
  note varchar(500)
  reference_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (medication_id, reference_id, type) [unique]
  }
}

Table medications {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  search_name varchar(255) [not null]
  unit varchar(50)
  caution text
  active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  unit_price numeric(12,2)
  stock_quantity integer [not null, default: 0]
  low_stock_threshold integer [not null, default: 0]
}

Table prescription_template_items {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null]
  medication_id uuid [not null]
  dosage varchar(100) [not null]
  frequency varchar(100) [not null]
  duration_days integer
  notes text
  sort_order integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table prescription_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  search_name varchar(150) [not null]
  diagnosis text [not null]
  treatment text
  notes text
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  sku varchar(64) [not null, unique]
  name varchar(200) [not null]
  description text
  price numeric(12,2) [not null]
  unit varchar(30) [not null]
  image_url varchar(500)
  stock_quantity integer [not null, default: 0]
  low_stock_threshold integer [not null, default: 0]
  active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table stock_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  type varchar(20) [not null]
  quantity_change integer [not null]
  quantity_after integer [not null]
  note varchar(500)
  reference_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (product_id, reference_id, type) [unique]
  }
}

Table cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (cart_id, product_id) [unique]
  }
}

Table carts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid [not null]
  sku varchar(64) [not null]
  product_name varchar(200) [not null]
  unit_price numeric(12,2) [not null]
  quantity integer [not null]
  line_total numeric(14,2) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table order_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_by uuid
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_code varchar(20) [not null, unique]
  user_id uuid
  status varchar(20) [not null]
  payment_method varchar(20)
  recipient_name varchar(200) [not null]
  recipient_phone varchar(20) [not null]
  shipping_address varchar(500) [not null]
  note varchar(500)
  subtotal numeric(14,2) [not null]
  shipping_fee numeric(14,2) [not null]
  total numeric(14,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancel_reason varchar(500)
  channel varchar(20) [not null, default: 'ONLINE']
  exam_payment_id uuid
  exam_amount numeric(14,2) [not null, default: 0]
  payment_status varchar(20) [not null, default: 'UNPAID']
  paid_at timestamptz
  transfer_reference varchar(100)
  payment_expires_at timestamptz
  gateway_txn_ref varchar(64)
  gateway_txn_created_at timestamptz
  customer_email varchar(255)
  assigned_staff_id uuid
  assigned_staff_name varchar(200)
  assigned_at timestamptz
}

Table payment_items {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  medication_name varchar(255) [not null]
  dosage varchar(100) [not null]
  frequency varchar(100) [not null]
  duration_days integer
  unit_price numeric(12,2)
  quantity integer
  line_amount numeric(12,2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  medical_record_id uuid [not null, unique]
  appointment_id uuid [not null]
  customer_user_id uuid [not null]
  amount numeric(12,2)
  method varchar(20)
  status varchar(20) [not null, default: 'PENDING_AMOUNT']
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  service_name varchar(120)
  service_amount numeric(12,2)
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  type varchar(40) [not null]
  title varchar(200) [not null]
  message varchar(1000) [not null]
  link varchar(300)
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table attendance_records {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  auto_closed boolean [not null, default: `false`]
  indexes {
    (user_id, date) [unique]
  }
}

Table leaves {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  reason varchar(500)
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, date) [unique]
  }
}

Table shifts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  note varchar(500)
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, date, start_time) [unique]
  }
}

// ===== Tham chiếu giữa các service (UUID, không có FK thật; đồng bộ qua Feign / RabbitMQ) =====
// auth-service: users.id là định danh người dùng dùng chung cho cả hệ thống
Ref: customer_profiles.user_id - users.id
Ref: doctor_profiles.user_id - users.id
Ref: staff_profiles.user_id - users.id
Ref: appointments.customer_user_id > users.id
Ref: appointment_slots.doctor_user_id > users.id
Ref: doctor_shifts.doctor_user_id > users.id
Ref: pets.owner_user_id > users.id
Ref: medical_records.customer_user_id > users.id
Ref: medical_records.doctor_user_id > users.id
Ref: carts.user_id > users.id
Ref: orders.user_id > users.id
Ref: orders.assigned_staff_id > users.id
Ref: order_status_history.changed_by > users.id
Ref: payments.customer_user_id > users.id
Ref: notifications.user_id > users.id
Ref: shifts.user_id > users.id
Ref: shifts.created_by > users.id
Ref: attendance_records.user_id > users.id
Ref: leaves.user_id > users.id
Ref: leaves.created_by > users.id
Ref: stock_movements.created_by > users.id
Ref: medication_stock_movements.created_by > users.id
Ref: prescription_templates.created_by > users.id
// booking-service <-> pet-service
Ref: appointments.pet_id > pets.id
Ref: medical_records.appointment_id - appointments.id
// payment-service
Ref: payments.appointment_id > appointments.id
Ref: payments.medical_record_id > medical_records.id
Ref: orders.exam_payment_id - payments.id
// order-service -> product-service
Ref: cart_items.product_id > products.id
Ref: order_items.product_id > products.id
// stock_movements.reference_id / medication_stock_movements.reference_id: tham chiếu đa hình (đơn hàng, phiếu khám...), không vẽ

// ===== Khoá ngoại thật trong cùng một database =====
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: refresh_tokens.user_id > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: addresses.customer_profile_id > customer_profiles.id
Ref: doctor_licenses.doctor_profile_id > doctor_profiles.id
Ref: appointments.slot_id > appointment_slots.id
Ref: appointments.service_id > clinic_services.id
Ref: medical_records.pet_id > pets.id
Ref: prescription_items.medical_record_id > medical_records.id
Ref: products.category_id > categories.id
Ref: stock_movements.product_id > products.id
Ref: prescription_template_items.template_id > prescription_templates.id
Ref: prescription_template_items.medication_id > medications.id
Ref: medication_stock_movements.medication_id > medications.id
Ref: cart_items.cart_id > carts.id
Ref: order_items.order_id > orders.id
Ref: order_status_history.order_id > orders.id
Ref: payment_items.payment_id > payments.id

TableGroup auth_service {
  password_reset_tokens
  refresh_tokens
  roles
  user_roles
  users
}

TableGroup profile_service {
  addresses
  customer_profiles
  doctor_licenses
  doctor_profiles
  staff_profiles
}

TableGroup booking_service {
  appointment_slots
  appointments
  blocked_doctors
  clinic_services
  doctor_shifts
}

TableGroup pet_service {
  medical_records
  pets
  prescription_items
}

TableGroup product_service {
  categories
  medication_stock_movements
  medications
  prescription_template_items
  prescription_templates
  products
  stock_movements
}

TableGroup order_service {
  cart_items
  carts
  order_items
  order_status_history
  orders
}

TableGroup payment_service {
  payment_items
  payments
}

TableGroup notification_service {
  notifications
}

TableGroup staff_service {
  attendance_records
  leaves
  shifts
}
